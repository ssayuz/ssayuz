# Docker 없이 돌릴 때: /etc/systemd/system/ssayuz.service
[Unit]
Description=ssayuz
After=network.target

[Service]
Type=simple
User=ssayuz
WorkingDirectory=/opt/ssayuz
EnvironmentFile=/opt/ssayuz/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
