<%- include('partials/header') %>
<% if (q) { %>
  <div class="cols-2">
    <section class="box">
      <div class="box-head"><h2 class="box-title">사람 · '<%= q %>'</h2></div>
      <div class="box-pad">
        <% if (people.length === 0) { %><div class="empty small">일치하는 사람이 없어요.</div><% } %>
        <% people.forEach(u => { %>
          <a class="person" href="/@<%= u.username %>">
            <img class="av av-44" src="<%= avatar(u) %>" alt="">
            <div><div class="bold">@<%= u.username %></div><div class="tiny muted light"><%= u.display_name %><%= u.bio ? ' · ' + u.bio : '' %></div></div>
          </a>
        <% }) %>
      </div>
    </section>
    <section class="box">
      <div class="box-head"><h2 class="box-title">방 · '<%= q %>'</h2></div>
      <div class="box-pad">
        <% if (roomsFound.length === 0) { %><div class="empty small">일치하는 방이 없어요.</div><% } %>
        <% roomsFound.forEach(r => { %>
          <a class="person" href="/talk/<%= r.slug %>">
            <span class="room-emoji"><%= r.emoji %></span>
            <div><div class="bold"><%= r.name %></div><div class="tiny muted light"><%= r.description %></div></div>
          </a>
        <% }) %>
      </div>
    </section>
  </div>
<% } %>
<div class="section-head mt">
  <div><span class="kicker">explore</span><h1 class="h1 mt"><%= tag ? '#' + tag : '둘러보기' %></h1></div>
  <form action="/explore" method="get" class="searchbar"><input type="search" name="tag" value="<%= tag %>" placeholder="#태그로 찾기" aria-label="태그"></form>
</div>
<%- include('partials/wall', { items: snaps, emptyText: tag ? '이 태그의 스냅이 아직 없어요.' : '아직 스냅이 없어요.' }) %>
<% if (nextBefore) { %><p class="center"><a class="btn" href="<%= qs('/explore', { tag, before: nextBefore }) %>">더 보기 ↓</a></p><% } %>
<%- include('partials/footer') %>
