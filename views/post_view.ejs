<%- include('partials/header') %>
<div class="post-detail">
  <%- include('partials/postcard', { p: Object.assign({}, post, { comments: null }) }) %>
  <section class="card pad" id="comments">
    <h2 class="box-title">댓글 <%= post.ccount %></h2>
    <% if (post.comments.length === 0) { %><div class="empty small">아직 댓글이 없어요.</div><% } %>
    <% post.comments.forEach(c => { %>
      <div class="ig-comment">
        <a href="/u/<%= c.username %>"><img class="av av-32" src="<%= avatar(c) %>" alt=""></a>
        <div class="grow">
          <p><a class="strong" href="/u/<%= c.username %>"><%= c.username %></a> <%- richText(c.body) %></p>
          <span class="muted small"><%= ago(c.created_at) %></span>
        </div>
        <% if (user && (user.id === c.user_id || user.id === post.user_id)) { %>
          <form method="post" action="/p/<%= post.id %>/comments/<%= c.id %>/delete" class="inline" data-confirm="댓글을 삭제할까요?">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn muted small">삭제</button>
          </form>
        <% } %>
      </div>
    <% }) %>
    <% if (user) { %>
      <form method="post" action="/p/<%= post.id %>/comment" class="comment-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input name="body" maxlength="1000" placeholder="댓글 달기..." required autocomplete="off">
        <button class="linkbtn accent strong">게시</button>
      </form>
    <% } else { %>
      <p class="small muted"><a href="/login?next=/p/<%= post.id %>">로그인</a>하고 댓글을 남겨 보세요.</p>
    <% } %>
    <% if (user && user.id === post.user_id) { %>
      <form method="post" action="/p/<%= post.id %>/delete" class="right" data-confirm="이 게시물을 삭제할까요? 되돌릴 수 없어요.">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">게시물 삭제</button>
      </form>
    <% } %>
  </section>
  <% if (more.length) { %>
    <section class="section">
      <div class="section-head"><h2 class="box-title"><%= post.username %>님의 게시물 더 보기</h2></div>
      <%- include('partials/grid', { items: more, emptyText: '' }) %>
    </section>
  <% } %>
</div>
<%- include('partials/footer') %>
