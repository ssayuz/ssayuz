<%- include('partials/header') %>
<section class="box narrow">
  <div class="box-head"><h1 class="box-title"><a href="/@<%= member.username %>">@<%= member.username %></a>의 <%= list === 'fans' ? '팬' : '찜' %></h1></div>
  <div class="box-pad">
    <% if (people.length === 0) { %><div class="empty small">아직 아무도 없어요.</div><% } %>
    <% people.forEach(u => { %>
      <a class="person" href="/@<%= u.username %>">
        <img class="av av-44" src="<%= avatar(u) %>" alt="">
        <div><div class="bold">@<%= u.username %></div><div class="tiny muted light"><%= u.display_name %></div></div>
      </a>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
