<%- include('partials/header') %>
<section class="feed box-pad-lg auth">
  <div class="center"><span class="logo big">ssayuz</span></div>
  <h1 class="h2 center">가입하기</h1>
  <p class="muted center small">짧게 말하고, 길게 이어지는 곳에 오신 걸 환영해요.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/signup" class="stack mt">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>아이디 <span class="muted light">(프로필 주소: ssayuz.kro.kr/@아이디)</span><input name="username" value="<%= form.username || '' %>" required minlength="3" maxlength="20" pattern="[a-zA-Z0-9_.]{3,20}" autocomplete="username" placeholder="영문, 숫자, _ ."></label>
    <label>이름<input name="display_name" value="<%= form.display_name || '' %>" required maxlength="20" placeholder="스레드에 보이는 이름"></label>
    <label>비밀번호<input type="password" name="password" required minlength="6" autocomplete="new-password" placeholder="6자 이상"></label>
    <button class="btn btn-ink btn-block">가입하기</button>
  </form>
  <p class="center small mt">이미 계정이 있나요? <a href="/login" class="bold">로그인</a></p>
</section>
<%- include('partials/footer') %>
