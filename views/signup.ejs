<%- include('partials/header') %>
<section class="card narrow pad-lg">
  <div class="logo big center">싸유즈</div>
  <p class="muted center">갤러리에서 떠들고, 피드에 사진을 남겨 보세요.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/signup" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>아이디<input name="username" value="<%= form.username || '' %>" required minlength="3" maxlength="20" pattern="[a-zA-Z0-9_.]{3,20}" autocomplete="username" placeholder="영문, 숫자, _ ."></label>
    <label>닉네임<input name="display_name" value="<%= form.display_name || '' %>" required maxlength="20" placeholder="갤러리와 프로필에 보이는 이름"></label>
    <label>비밀번호<input type="password" name="password" required minlength="6" autocomplete="new-password"></label>
    <button class="btn btn-primary btn-block">가입하기</button>
  </form>
  <p class="center small">이미 계정이 있나요? <a href="/login">로그인</a></p>
</section>
<%- include('partials/footer') %>
