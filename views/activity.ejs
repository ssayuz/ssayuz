<%- include('partials/header') %>
<% const say = {
  like: '내 Snippet을 좋아해요',
  reply: '내 Snippet에 답글을 달았어요',
  repost: '내 Snippet을 리포스트했어요',
  quote: '내 Snippet을 인용했어요',
  follow: '나를 팔로우하기 시작했어요',
  mention: '나를 언급했어요',
}; %>
<div class="page-head"><span class="icon-btn"></span><h1 class="page-title">활동</h1>
  <% if (notes.length) { %>
    <form method="post" action="/activity/clear" data-confirm="활동 기록을 모두 지울까요?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn small">모두 지우기</button></form>
  <% } else { %><span class="icon-btn"></span><% } %>
</div>
<section class="feed">
  <% if (notes.length === 0) { %><div class="empty">아직 활동이 없어요.<br><span class="small">누군가 좋아요를 누르거나 답글을 달면 여기에 보여요.</span></div><% } %>
  <% notes.forEach(n => { %>
    <a class="note <%= n.read_at ? '' : 'unread' %>" href="<%= n.link %>">
      <span class="note-av"><%- avatar({ username: n.actor_username || n.actor_name, display_name: n.display_name || n.actor_name }, 40) %><span class="note-ico t-<%= n.type %>"><%- icon({ like: 'heart', reply: 'reply', repost: 'repost', quote: 'quote', follow: 'user', mention: 'reply' }[n.type] || 'heart', 11) %></span></span>
      <div class="grow">
        <div class="small"><b>@<%= n.actor_name %></b>님이 <%= say[n.type] || '' %> <span class="muted"><%= ago(n.created_at) %></span></div>
        <% if (n.snippet) { %><div class="note-snippet small muted"><%= n.snippet %></div><% } %>
      </div>
      <% if (!n.read_at) { %><span class="new-dot" aria-label="새 활동"></span><% } %>
    </a>
  <% }) %>
</section>
<%- include('partials/footer') %>
