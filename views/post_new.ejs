<%- include('partials/header') %>
<section class="card narrow pad-lg">
  <h1 class="h2 center">새 게시물 만들기</h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/p/new?_csrf=<%= csrf %>" enctype="multipart/form-data" class="stack">
    <label class="dropzone">
      <input type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple required data-preview="#preview">
      <span class="dz-text">📷 사진 고르기 <span class="muted small">(최대 10장)</span></span>
    </label>
    <div id="preview" class="preview"></div>
    <label>문구<textarea name="caption" rows="4" maxlength="2200" placeholder="문구를 입력하세요... #해시태그 @멘션"><%= caption %></textarea></label>
    <button class="btn btn-primary btn-block">공유하기</button>
  </form>
</section>
<%- include('partials/footer') %>
