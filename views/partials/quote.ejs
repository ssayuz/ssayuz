<% if (q.missing) { %>
  <div class="quote quote-missing">볼 수 없는 스레드예요.</div>
<% } else { %>
  <a class="quote" href="/@<%= q.username %>/post/<%= q.id %>">
    <span class="quote-head"><%- avatar(q, 20) %><b><%= q.display_name %></b><span class="handle">@<%= q.username %></span><span class="muted">· <%= ago(q.created_at) %></span></span>
    <span class="quote-body"><%= q.body %></span>
  </a>
<% } %>
