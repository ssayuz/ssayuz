<%
  const c = typeof cfg !== 'undefined' ? cfg : {};
  const parts = c.parts && c.parts.length ? c.parts : [''];
%>
<form method="post" action="/compose" class="composer <%= c.compact ? 'compact' : '' %>" id="<%= c.id || 'composer' %>" data-max="<%= POST_MAX %>" data-max-parts="<%= c.maxParts || 10 %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (c.parentId) { %><input type="hidden" name="parent_id" value="<%= c.parentId %>"><% } %>
  <% if (c.quoteId) { %><input type="hidden" name="quote_id" value="<%= c.quoteId %>"><% } %>
  <% if (c.back) { %><input type="hidden" name="back" value="<%= c.back %>"><% } %>
  <div class="parts">
    <% parts.forEach((t, i) => { %>
      <div class="part">
        <div class="part-av"><%- avatar(user, 40) %></div>
        <div class="part-main">
          <div class="part-head"><b><%= user.display_name %></b><% if (i > 0) { %><button type="button" class="linkbtn tiny part-remove">빼기</button><% } %></div>
          <textarea name="body" rows="<%= c.compact ? 2 : 3 %>" placeholder="<%= c.placeholder || (i === 0 ? '무슨 생각 해요?' : '이어서 쓰기...') %>" aria-label="Snippet 내용"><%= t %></textarea>
          <div class="part-foot"><span class="count"></span></div>
        </div>
      </div>
    <% }) %>
  </div>
  <% if (c.quoteHtml) { %><div class="composer-quote"><%- c.quoteHtml %></div><% } %>
  <div class="composer-bar">
    <button type="button" class="linkbtn add-part"><%- icon('plus', 16) %> 이어서 쓰기</button>
    <span class="grow"></span>
    <% if (!c.parentId) { %>
      <label class="policy"><span class="sr">답글 허용 범위</span>
        <select name="reply_policy">
          <option value="all" <%= c.policy === 'all' || !c.policy ? 'selected' : '' %>>누구나 답글</option>
          <option value="following" <%= c.policy === 'following' ? 'selected' : '' %>>내가 팔로우하는 사람만</option>
          <option value="mentioned" <%= c.policy === 'mentioned' ? 'selected' : '' %>>언급한 사람만</option>
        </select>
      </label>
    <% } %>
    <button class="btn btn-ink btn-sm post-btn"><%= c.parentId ? '답글 달기' : '게시' %></button>
  </div>
</form>
