</main>
<footer class="foot wrap"><b>ssayuz</b> · 말은 토크로, 순간은 스냅으로</footer>
<nav class="dock" aria-label="빠른 이동">
  <a href="/" class="<%= path === '/' ? 'on' : '' %>"><span class="d-ico">◐</span>홈</a>
  <a href="/talk" class="<%= path.startsWith('/talk') ? 'on' : '' %>"><span class="d-ico">✎</span>토크</a>
  <a href="/snap/new" class="d-plus"><span class="d-ico">＋</span>올리기</a>
  <a href="/snap" class="<%= path === '/snap' || path.startsWith('/explore') ? 'on' : '' %>"><span class="d-ico">✦</span>스냅</a>
  <% if (user) { %>
    <a href="/@<%= user.username %>" class="<%= path.startsWith('/@' + user.username) ? 'on' : '' %>"><span class="d-ico">⌂</span>내 룸</a>
  <% } else { %>
    <a href="/login"><span class="d-ico">→</span>들어가기</a>
  <% } %>
</nav>
</body>
</html>
