<% if (w.username) { %><a class="writer" href="/@<%= w.username %>"><% if (typeof noAv === 'undefined' || !noAv) { %><img class="av av-20" src="<%= avatar(w) %>" alt=""><% } %><span class="writer-name"><%= w.display_name %></span><span class="tag tag-regular">단골</span></a><% } else { %><span class="writer"><span class="tag tag-guest">손님</span><span class="writer-name"><%= w.nickname %></span><% if (w.ip_prefix) { %><span class="ip"><%= w.ip_prefix %></span><% } %></span><% } %>
