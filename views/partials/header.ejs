<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' — ssayuz' : 'ssayuz — 말은 토크로, 순간은 스냅으로' %></title>
<meta name="csrf-token" content="<%= csrf %>">
<meta name="theme-color" content="#c9f23d">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/static/fonts/GmarketSansMedium.woff" as="font" type="font/woff" crossorigin>
<link rel="preload" href="/static/fonts/GmarketSansBold.woff" as="font" type="font/woff" crossorigin>
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-in">
    <a class="logo" href="/" aria-label="ssayuz 홈">ssayuz</a>
    <nav class="topnav">
      <a href="/talk" class="<%= path.startsWith('/talk') ? 'on' : '' %>">토크</a>
      <a href="/snap" class="<%= path.startsWith('/snap') ? 'on' : '' %>">스냅</a>
      <a href="/explore" class="<%= path.startsWith('/explore') ? 'on' : '' %>">둘러보기</a>
    </nav>
    <form class="topsearch" action="/explore" method="get" role="search">
      <input type="search" name="q" placeholder="사람, 방 찾기" aria-label="사람, 방 찾기">
    </form>
    <div class="topright">
      <% if (user) { %>
        <a class="btn btn-lime btn-sm hide-sm" href="/snap/new">＋ 스냅</a>
        <a href="/@<%= user.username %>" title="내 프로필"><img class="av av-36" src="<%= avatar(user) %>" alt="내 프로필"></a>
        <form method="post" action="/logout" class="inline hide-sm">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linkbtn small">로그아웃</button>
        </form>
      <% } else { %>
        <a href="/login?next=<%= encodeURIComponent(path) %>" class="btn btn-sm">로그인</a>
        <a class="btn btn-ink btn-sm" href="/signup">가입</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap main">
