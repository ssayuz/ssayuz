<% if (isAdmin) { %><form method="post" action="/admin/hide" class="inline">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="id" value="<%= id %>"><input type="hidden" name="back" value="<%= back %>">
  <button class="<%= typeof small !== 'undefined' && small ? 'linkbtn tiny admin-link' : 'btn btn-sm btn-admin' %>">🛡 <%= hidden ? '복구' : '숨기기' %></button>
</form><% } %>
