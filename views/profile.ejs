<%- include('partials/header') %>
<section class="profile">
  <div class="profile-av"><span class="ring ring-lg"><img class="av av-120" src="<%= avatar(profile) %>" alt="<%= profile.username %> 프로필 사진"></span></div>
  <div class="profile-info">
    <div class="profile-top">
      <h1 class="h2"><%= profile.username %></h1>
      <% if (isMe) { %>
        <a class="btn btn-ghost btn-sm" href="/settings">프로필 편집</a>
      <% } else if (user) { %>
        <form method="post" action="/u/<%= profile.username %>/follow" class="inline follow-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm <%= following ? 'btn-ghost' : 'btn-primary' %>" data-following="<%= following ? '1' : '0' %>"><%= following ? '팔로잉' : '팔로우' %></button>
        </form>
      <% } else { %>
        <a class="btn btn-primary btn-sm" href="/login?next=/u/<%= profile.username %>">팔로우</a>
      <% } %>
    </div>
    <ul class="profile-stats">
      <li>게시물 <strong><%= num(profile.post_count) %></strong></li>
      <li><a href="/u/<%= profile.username %>/followers">팔로워 <strong class="follower-count"><%= num(profile.followers) %></strong></a></li>
      <li><a href="/u/<%= profile.username %>/following">팔로우 <strong><%= num(profile.following) %></strong></a></li>
    </ul>
    <div class="strong"><%= profile.display_name %></div>
    <% if (profile.bio) { %><p class="bio"><%- richText(profile.bio) %></p><% } %>
  </div>
</section>
<nav class="tabs">
  <a href="/u/<%= profile.username %>" class="<%= tab === 'posts' ? 'on' : '' %>">▦ 게시물</a>
  <a href="/u/<%= profile.username %>?tab=gallery" class="<%= tab === 'gallery' ? 'on' : '' %>">☰ 갤러리 글 <span class="muted"><%= profile.gpost_count %></span></a>
</nav>
<% if (tab === 'posts') { %>
  <%- include('partials/grid', { items: posts, emptyText: isMe ? '첫 사진을 공유해 보세요.' : '아직 게시물이 없어요.' }) %>
<% } else { %>
  <% if (gposts.length === 0) { %><div class="empty">갤러리에 쓴 글이 없어요.</div><% } else { %>
  <table class="board">
    <thead><tr><th class="c-gal">갤러리</th><th>제목</th><th class="c-date">작성일</th><th class="c-num">조회</th><th class="c-num">추천</th></tr></thead>
    <tbody>
      <% gposts.forEach(p => { %>
        <tr>
          <td class="c-gal"><a href="/g/<%= p.slug %>"><%= p.gname %></a></td>
          <td class="c-title"><a href="/g/<%= p.slug %>/<%= p.id %>"><%= p.title %></a><% if (p.ccount) { %> <span class="reply">[<%= p.ccount %>]</span><% } %></td>
          <td class="c-date"><%= dcTime(p.created_at) %></td><td class="c-num"><%= num(p.views) %></td><td class="c-num"><%= p.up %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
<% } %>
<%- include('partials/footer') %>
