<%- include('partials/header') %>
<section class="feed">
  <div class="profile">
    <div class="profile-top">
      <div class="grow">
        <h1 class="profile-name"><%= member.display_name %></h1>
        <div class="profile-handle">@<%= member.username %><% if (followsMe) { %> <span class="tag">나를 팔로우해요</span><% } %><% if (member.role === 'admin') { %> <span class="tag tag-user">관리자</span><% } %></div>
      </div>
      <%- avatar(member, 84) %>
    </div>
    <% if (member.banned_at) { %><div class="alert mt">이용이 제한된 계정이에요.</div><% } %>
    <% if (member.bio) { %><p class="bio"><%- richText(member.bio) %></p><% } %>
    <div class="profile-meta">
      <a href="/@<%= member.username %>/followers">팔로워 <b class="follower-count"><%= num(member.followers) %></b>명</a>
      <span>·</span>
      <a href="/@<%= member.username %>/following">팔로잉 <b><%= num(member.following) %></b>명</a>
      <% if (member.link) { %><span>·</span><a class="profile-link" href="<%= member.link %>" target="_blank" rel="noopener noreferrer nofollow"><%- icon('link', 15) %> <%= member.link.replace(/^https?:\/\//, '').slice(0, 30) %></a><% } %>
    </div>
    <div class="profile-btns">
      <% if (isMe) { %>
        <a class="btn btn-block" href="/settings">프로필 편집</a>
        <button type="button" class="btn btn-block" data-copy="<%= siteUrl %>/@<%= member.username %>">프로필 공유</button>
      <% } else if (user) { %>
        <form method="post" action="/@<%= member.username %>/follow" class="follow-form grow">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-block <%= following ? '' : 'btn-ink' %>"><%= following ? '팔로잉' : (followsMe ? '맞팔로우' : '팔로우') %></button>
        </form>
        <% if (!member.banned_at) { %><a class="btn btn-block grow" href="/dm/@<%= member.username %>">메시지</a><% } %>
      <% } else { %>
        <a class="btn btn-ink btn-block" href="/login?next=/@<%= member.username %>">팔로우</a>
      <% } %>
    </div>
    <% if (isAdmin && !isMe) { %>
      <div class="admin-bar" id="admin">
        <%- icon('shield', 18) %> <b>관리</b>
        <% if (member.role === 'admin') { %>
          <span class="small muted">관리자 계정이에요</span>
        <% } else if (member.banned_at) { %>
          <span class="small">차단됨<%= member.ban_reason ? ' · ' + member.ban_reason : '' %></span>
          <form method="post" action="/admin/users/<%= member.id %>/unban" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/@<%= member.username %>"><button class="btn btn-sm">차단 해제</button></form>
        <% } else { %>
          <form method="post" action="/admin/users/<%= member.id %>/ban" class="inline ban-form" data-confirm="@<%= member.username %> 계정을 차단할까요? 바로 로그아웃돼요.">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/@<%= member.username %>">
            <input name="reason" placeholder="사유 (선택)" maxlength="100" aria-label="차단 사유"><button class="btn btn-sm btn-danger">계정 차단</button>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>
  <nav class="feed-tabs in-profile">
    <a href="/@<%= member.username %>" class="<%= tab === 'threads' ? 'on' : '' %>">Snippet</a>
    <a href="/@<%= member.username %>?tab=replies" class="<%= tab === 'replies' ? 'on' : '' %>">답글</a>
    <a href="/@<%= member.username %>?tab=reposts" class="<%= tab === 'reposts' ? 'on' : '' %>">리포스트</a>
  </nav>
  <% if (isMe && tab === 'threads') { %><%- include('partials/composer', { cfg: { compact: true, id: 'profile-composer' } }) %><% } %>
  <% if (posts.length === 0) { %>
    <div class="empty"><%= tab === 'threads' ? '아직 Snippet이 없어요.' : tab === 'replies' ? '아직 답글이 없어요.' : '아직 리포스트한 Snippet이 없어요.' %></div>
  <% } %>
  <% posts.forEach(p => { %><%- include('partials/post', { p, opts: { showParent: tab === 'replies', repostedBy: tab === 'reposts' ? member.username : null } }) %><% }) %>
</section>
<%- include('partials/footer') %>
