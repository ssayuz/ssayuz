<%- include('partials/header') %>
<div class="page-head"><a class="icon-btn" href="/@<%= user.username %>" aria-label="뒤로"><%- icon('back') %></a><h1 class="page-title">프로필 편집</h1><span class="icon-btn"></span></div>
<section class="feed box-pad">
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <% if (saved) { %><div class="alert ok">저장했어요 ✓ <a class="bold" href="/@<%= user.username %>">프로필 보기 →</a></div><% } %>
  <form method="post" action="/settings" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><%- avatar(Object.assign({}, user, { display_name: form.display_name }), 64) %><div class="small muted">프로필 사진은 이름 첫 글자로 만들어져요.</div></div>
    <label>아이디<input value="@<%= user.username %>" disabled></label>
    <label>이름<input name="display_name" value="<%= form.display_name %>" required maxlength="20"></label>
    <label>소개<textarea name="bio" rows="3" maxlength="150" placeholder="나를 소개해 주세요"><%= form.bio %></textarea></label>
    <label>링크<input name="link" value="<%= form.link %>" maxlength="200" placeholder="https://"></label>
    <button class="btn btn-ink btn-block">저장</button>
  </form>
  <form method="post" action="/logout" class="mt center">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">로그아웃</button>
  </form>
</section>
<%- include('partials/footer') %>
