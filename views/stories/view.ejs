<%- include('../partials/header') %>
<section class="story-stage" data-start="<%= start %>" data-next="<%= nextUser ? '/stories/@' + nextUser : '/snap' %>" data-owner="<%= isOwner ? '1' : '' %>">
  <div class="story-bars"><% stories.forEach((s, i) => { %><span class="<%= i < start ? 'done' : '' %>"><i></i></span><% }) %></div>
  <header class="story-head">
    <a href="/@<%= owner.username %>"><img class="av av-36" src="<%= avatar(owner) %>" alt=""></a>
    <a class="bold" href="/@<%= owner.username %>">@<%= owner.username %></a>
    <span class="story-time tiny light"></span>
    <span class="grow"></span>
    <button type="button" class="story-pause" aria-label="일시정지">❚❚</button>
    <a class="story-close" href="/snap" aria-label="닫기">✕</a>
  </header>
  <% stories.forEach((s, i) => { %>
    <figure class="story <%= i === start ? 'on' : '' %>" data-id="<%= s.id %>" data-ago="<%= ago(s.created_at) %>" data-left="<%= Math.max(1, Math.ceil((s.created_at + 86400000 - Date.now()) / 3600000)) %>">
      <img src="/uploads/<%= s.image %>" alt="@<%= owner.username %>의 스토리 <%= i + 1 %>">
      <% if (s.caption) { %><figcaption><%= s.caption %></figcaption><% } %>
      <% if (isOwner) { %>
        <div class="story-owner">
          <details>
            <summary>👀 <%= s.viewers.length %>명이 봤어요 · <%= Math.max(1, Math.ceil((s.created_at + 86400000 - Date.now()) / 3600000)) %>시간 뒤 사라져요</summary>
            <div class="story-viewers">
              <% if (!s.viewers.length) { %><span class="tiny">아직 아무도 안 봤어요</span><% } %>
              <% s.viewers.forEach(v => { %><a href="/@<%= v.username %>"><img class="av av-20" src="<%= avatar(v) %>" alt=""> @<%= v.username %></a><% }) %>
            </div>
          </details>
          <form method="post" action="/stories/<%= s.id %>/delete" data-confirm="이 스토리를 지울까요?">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">지우기</button>
          </form>
        </div>
      <% } %>
    </figure>
  <% }) %>
  <a class="story-tap prev" href="<%= start > 0 ? '?i=' + start : '/snap' %>" aria-label="이전"></a>
  <a class="story-tap next" href="<%= start + 1 < stories.length ? '?i=' + (start + 2) : (nextUser ? '/stories/@' + nextUser : '/snap') %>" aria-label="다음"></a>
</section>
<%- include('../partials/footer') %>
