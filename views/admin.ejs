<%- include('partials/header') %>
<div class="page-head"><span class="icon-btn"></span><h1 class="page-title"><%- icon('shield', 20) %> 관리</h1><span class="icon-btn"></span></div>
<div class="stat-grid">
  <div class="stat-card"><b><%= stats.users %></b><span>가입자</span></div>
  <div class="stat-card"><b><%= stats.banned %></b><span>차단 계정</span></div>
  <div class="stat-card"><b><%= stats.postsToday %></b><span>오늘 Snippet</span></div>
  <div class="stat-card"><b><%= stats.hidden %></b><span>숨긴 Snippet</span></div>
</div>
<nav class="feed-tabs">
  <a href="/admin" class="<%= tab === 'overview' ? 'on' : '' %>">최근 Snippet</a>
  <a href="/admin?tab=users" class="<%= tab === 'users' ? 'on' : '' %>">사용자</a>
  <a href="/admin?tab=hidden" class="<%= tab === 'hidden' ? 'on' : '' %>">숨긴 Snippet</a>
  <a href="/admin?tab=log" class="<%= tab === 'log' ? 'on' : '' %>">기록</a>
</nav>
<section class="feed">
<% const postRows = (rows, backUrl) => rows.forEach(p => { %>
  <div class="admin-row <%= p.hidden_at ? 'is-hidden' : '' %>">
    <div class="grow">
      <a href="/@<%= p.username %>/post/<%= p.id %>" class="admin-body"><%= p.body.slice(0, 120) || '(내용 없음)' %></a>
      <div class="tiny muted">@<%= p.username %> · <%= p.parent_id ? '답글' : 'Snippet' %> · <%= ago(p.created_at) %><% if (p.hidden_at) { %> · <b>숨김</b><% } %></div>
    </div>
    <form method="post" action="/admin/hide" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= p.id %>"><input type="hidden" name="back" value="<%= backUrl %>">
      <button class="btn btn-sm"><%= p.hidden_at ? '복구' : '숨기기' %></button>
    </form>
  </div>
<% }) %>
<% if (tab === 'overview') { %>
  <% if (!recent.length) { %><div class="empty">아직 Snippet이 없어요.</div><% } %>
  <% postRows(recent, '/admin') %>
<% } else if (tab === 'hidden') { %>
  <% if (!hidden.length) { %><div class="empty">숨긴 Snippet이 없어요.</div><% } %>
  <% postRows(hidden, '/admin?tab=hidden') %>
<% } else if (tab === 'users') { %>
  <form class="searchbox" method="get" action="/admin"><%- icon('search', 20) %><input type="hidden" name="tab" value="users"><input type="search" name="q" value="<%= q %>" placeholder="아이디나 이름" aria-label="사용자 검색"></form>
  <% users.forEach(u => { %>
    <div class="admin-row <%= u.banned_at ? 'is-hidden' : '' %>">
      <div class="grow">
        <a class="bold" href="/@<%= u.username %>">@<%= u.username %></a> <span class="small"><%= u.display_name %></span>
        <% if (u.role === 'admin') { %><span class="tag tag-user">관리자</span><% } %>
        <% if (u.banned_at) { %><span class="tag tag-hot">차단됨</span><% } %>
        <div class="tiny muted">Snippet <%= u.posts %> · 가입 <%= ago(u.created_at) %><% if (u.ban_reason) { %> · 사유: <%= u.ban_reason %><% } %></div>
      </div>
      <% if (u.id !== user.id) { %>
        <% if (u.banned_at) { %>
          <form method="post" action="/admin/users/<%= u.id %>/unban" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">차단 해제</button></form>
        <% } else if (u.role !== 'admin') { %>
          <form method="post" action="/admin/users/<%= u.id %>/ban" class="inline ban-form" data-confirm="@<%= u.username %> 계정을 차단할까요? 바로 로그아웃돼요.">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" placeholder="사유 (선택)" maxlength="100" aria-label="차단 사유"><button class="btn btn-sm btn-danger">차단</button>
          </form>
        <% } %>
        <% if (!u.banned_at) { %>
          <form method="post" action="/admin/users/<%= u.id %>/role" class="inline" data-confirm="권한을 바꿀까요?">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>">
            <button class="linkbtn tiny"><%= u.role === 'admin' ? '관리자 해제' : '관리자로' %></button>
          </form>
        <% } %>
      <% } else { %><span class="tiny muted">나</span><% } %>
    </div>
  <% }) %>
  <% if (!users.length) { %><div class="empty">없어요.</div><% } %>
<% } else { %>
  <% if (!log.length) { %><div class="empty">기록이 없어요.</div><% } %>
  <% log.forEach(l => { %>
    <div class="admin-row"><div class="grow"><b><%= l.action %></b> · <%= l.target %><% if (l.note) { %> <span class="muted">— <%= l.note %></span><% } %><div class="tiny muted">@<%= l.admin || '?' %> · <%= fullTime(l.created_at) %></div></div></div>
  <% }) %>
<% } %>
</section>
<%- include('partials/footer') %>
