<%- include('partials/header') %>
<div class="page-head"><a class="icon-btn" href="/" data-back aria-label="뒤로"><%- icon('back') %></a><h1 class="page-title">Snippet</h1><span class="icon-btn"></span></div>
<section class="feed">
  <% ancestors.forEach(a => { %><%- include('partials/post', { p: a, opts: { line: true } }) %><% }) %>
  <%- include('partials/post', { p: post, opts: { big: true } }) %>
  <div id="reply">
    <% if (canReply) { %>
      <%- include('partials/composer', { cfg: { compact: true, id: 'reply-composer', parentId: post.id, back: '/@' + post.username + '/post/' + post.id, placeholder: '@' + post.username + '님에게 답글...' } }) %>
    <% } else if (!user && !post.deleted_at) { %>
      <div class="reply-locked"><a class="bold" href="/login?next=<%= encodeURIComponent('/@' + post.username + '/post/' + post.id) %>">로그인</a>하고 답글을 남겨 보세요.</div>
    <% } else if (!post.deleted_at) { %>
      <div class="reply-locked">작성자가 답글을 달 수 있는 사람을 제한했어요.</div>
    <% } %>
  </div>
  <% if (replies.length) { %><div class="section-label">답글 <%= replies.length %></div><% } %>
  <% replies.forEach(r => { %><%- include('partials/post', { p: r }) %><% }) %>
</section>
<%- include('partials/footer') %>
