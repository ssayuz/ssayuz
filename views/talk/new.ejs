<%- include('../partials/header') %>
<section class="box box-pad-lg narrow">
  <span class="kicker">new room</span>
  <h1 class="h2 mt">방 만들기</h1>
  <p class="muted small light">같은 걸 좋아하는 사람들이 모일 방을 열어 보세요.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/talk/new" class="stack mt">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset class="emoji-pick">
      <legend class="small bold">대표 이모지</legend>
      <% emojis.forEach(e => { %><label><input type="radio" name="emoji" value="<%= e %>" <%= form.emoji === e ? 'checked' : '' %>><span><%= e %></span></label><% }) %>
    </fieldset>
    <label>방 이름<input name="name" value="<%= form.name || '' %>" required maxlength="20" placeholder="예: 고양이 집사들"></label>
    <label>주소<div class="addon"><span>/talk/</span><input name="slug" value="<%= form.slug || '' %>" required pattern="[a-z0-9_]{2,20}" maxlength="20" placeholder="cats"></div></label>
    <label>한 줄 소개<input name="description" value="<%= form.description || '' %>" maxlength="100" placeholder="어떤 방인가요?"></label>
    <button class="btn btn-ink btn-block">방 열기 →</button>
  </form>
</section>
<%- include('../partials/footer') %>
