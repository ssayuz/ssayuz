<%- include('../partials/header') %>
<section class="room-banner">
  <span class="room-emoji"><%= room.emoji %></span>
  <div class="grow">
    <h1><a href="/talk/<%= room.slug %>"><%= room.name %></a><% if (room.is_user) { %> <span class="tag tag-user">USER</span><% } %></h1>
    <p class="muted small light"><%= room.description %></p>
  </div>
  <a class="btn btn-lime" href="/talk/<%= room.slug %>/write">✎ 글쓰기</a>
</section>
<div class="toolbar">
  <nav class="seg">
    <a href="<%= qs('/talk/' + room.slug, { topic, q }) %>" class="<%= sort === 'new' ? 'on' : '' %>">최신</a>
    <a href="<%= qs('/talk/' + room.slug, { sort: 'hot', topic, q }) %>" class="<%= sort === 'hot' ? 'on' : '' %>">🔥 불타는 글</a>
  </nav>
  <nav class="chip-row">
    <a href="<%= qs('/talk/' + room.slug, { sort: sort === 'hot' ? 'hot' : '', q }) %>" class="chip <%= !topic ? 'on' : '' %>">전체</a>
    <% topics.forEach(tp => { %><a href="<%= qs('/talk/' + room.slug, { sort: sort === 'hot' ? 'hot' : '', topic: tp, q }) %>" class="chip <%= topic === tp ? 'on' : '' %>"><%= tp %></a><% }) %>
  </nav>
</div>
<% if (q) { %><p class="small muted">'<b><%= q %></b>' 찾은 결과 <%= total %>개 · <a class="bold" href="<%= qs('/talk/' + room.slug, { sort: sort === 'hot' ? 'hot' : '', topic }) %>">지우기</a></p><% } %>
<div class="talk-list">
  <% if (talks.length === 0) { %>
    <div class="box empty"><%= sort === 'hot' ? '화력 ' + threshold + ' 이상인 글이 아직 없어요.' : '아직 조용한 방이에요. 첫 글을 남겨 보세요!' %></div>
  <% } %>
  <% talks.forEach(t => { const imgs = images(t.images); %>
    <article class="talk-item <%= t.fire - t.ice >= threshold ? 'is-hot' : '' %>">
      <%- include('../partials/heat', { t, threshold }) %>
      <div class="talk-main">
        <a class="talk-title" href="/talk/<%= room.slug %>/<%= t.id %>"><span class="tag"><%= t.topic %></span> <%= t.title %><% if (t.ccount) { %> <span class="cc">+<%= t.ccount %></span><% } %></a>
        <% if (t.excerpt) { %><div class="talk-excerpt"><%= t.excerpt %></div><% } %>
        <div class="talk-meta">
          <%- include('../partials/writer', { w: t }) %>
          <span title="<%= fullTime(t.created_at) %>"><%= ago(t.created_at) %></span>
          <span>👀 <%= num(t.views) %></span>
        </div>
      </div>
      <% if (imgs.length) { %><img class="talk-thumb" src="/uploads/<%= imgs[0] %>" alt="" loading="lazy"><% } %>
    </article>
  <% }) %>
</div>
<div class="list-foot">
  <form class="searchbar" method="get" action="/talk/<%= room.slug %>">
    <% if (sort === 'hot') { %><input type="hidden" name="sort" value="hot"><% } %>
    <% if (topic) { %><input type="hidden" name="topic" value="<%= topic %>"><% } %>
    <input type="search" name="q" value="<%= q %>" placeholder="이 방에서 찾기" maxlength="50">
    <button class="btn btn-sm">찾기</button>
  </form>
  <a class="btn btn-ink btn-sm" href="/talk/<%= room.slug %>/write">✎ 글쓰기</a>
</div>
<%- include('../partials/pager', { base: '/talk/' + room.slug, params: { sort: sort === 'hot' ? 'hot' : '', topic, q }, page, pages }) %>
<%- include('../partials/footer') %>
