<%- include('../partials/header') %>
<div class="section-head">
  <div><span class="kicker">talk</span><h1 class="h1 mt">어느 방으로 갈까요?</h1></div>
  <a class="btn btn-ink btn-sm" href="/talk/new">＋ 방 만들기</a>
</div>
<div class="room-grid">
  <% official.forEach(r => { %>
    <a class="room-card" href="/talk/<%= r.slug %>">
      <span class="room-emoji"><%= r.emoji %></span>
      <span class="room-name"><%= r.name %></span>
      <span class="small muted light"><%= r.description %></span>
      <span class="room-stat">오늘 <b><%= r.today %></b> · 전체 <%= num(r.total) %></span>
    </a>
  <% }) %>
</div>
<section class="section">
  <div class="section-head"><h2 class="h2">단골들이 만든 방</h2></div>
  <% if (custom.length === 0) { %>
    <div class="box empty small">아직 없어요. 가입하고 내 방을 열어 보세요!</div>
  <% } else { %>
  <div class="room-grid">
    <% custom.forEach(r => { %>
      <a class="room-card" href="/talk/<%= r.slug %>">
        <span class="room-emoji"><%= r.emoji %></span>
        <span class="room-name"><%= r.name %> <span class="tag tag-user">USER</span></span>
        <span class="small muted light"><%= r.description %></span>
        <span class="room-stat">오늘 <b><%= r.today %></b> · 전체 <%= num(r.total) %></span>
      </a>
    <% }) %>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
