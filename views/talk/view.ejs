<%- include('../partials/header') %>
<% const msgs = { voted: '이미 🔥 또는 🧊 를 눌렀어요.', bad_pw: '비밀번호가 틀렸거나 권한이 없어요.', comment_len: '댓글은 1~1000자로 써 주세요.', comment_pw: '손님 댓글은 비밀번호(2자 이상)가 필요해요.', slow: '너무 빨라요. 잠깐만 쉬었다가 다시 해 주세요.' }; %>
<% if (msgs[msg]) { %><div class="alert"><%= msgs[msg] %></div><% } %>
<article class="box">
  <% if (talk.hidden_at) { %><span class="hidden-flag">🛡 관리자가 숨긴 글이에요. 관리자에게만 보여요.</span><% } %>
  <header class="article-head">
    <div class="row wrap-row">
      <a class="tag" href="/talk/<%= room.slug %>"><%= room.emoji %> <%= room.name %></a>
      <span class="tag"><%= talk.topic %></span>
      <% if (hot) { %><span class="tag tag-hot">🔥 불타는 글</span><% } %>
    </div>
    <h1 class="article-title"><%= talk.title %></h1>
    <div class="article-meta">
      <%- include('../partials/writer', { w: talk }) %>
      <span class="light"><%= fullTime(talk.created_at) %></span>
      <span class="grow"></span>
      <span>👀 <%= num(talk.views) %></span><span>💬 <%= comments.length %></span>
    </div>
  </header>
  <div class="article-body">
    <% imgs.forEach(src => { %><img src="/uploads/<%= src %>" alt="" loading="lazy"><% }) %>
    <% if (talk.body) { %><div class="article-text"><%- nl2br(talk.body) %></div><% } %>
  </div>
  <% const total = talk.fire + talk.ice; const fp = total ? Math.round(talk.fire / total * 100) : 50; %>
  <section class="heatbox" id="heat">
    <div class="heat-btns">
      <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/vote" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="fire">
        <button class="heat-btn fire <%= myVote === 1 ? 'on' : '' %>">🔥 불지피기 <span class="n"><%= talk.fire %></span></button>
      </form>
      <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/vote" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="ice">
        <button class="heat-btn ice <%= myVote === -1 ? 'on' : '' %>">🧊 찬물 <span class="n"><%= talk.ice %></span></button>
      </form>
    </div>
    <div class="meter" role="img" aria-label="불 <%= talk.fire %>, 찬물 <%= talk.ice %>"><span class="f w<%= Math.round(fp / 5) * 5 %>"></span><span class="i"></span></div>
    <div class="meter-cap">화력 <b><%= talk.fire - talk.ice %></b> · <%= threshold %> 이상이면 불타는 글</div>
  </section>
  <div class="article-tools">
    <a class="btn btn-sm" href="/talk/<%= room.slug %>">목록</a>
    <% if (talk.user_id) { %>
      <% if (user && user.id === talk.user_id) { %>
        <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/delete" class="inline" data-confirm="이 글을 지울까요?">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">지우기</button>
        </form>
      <% } %>
    <% } else { %>
      <details class="pwdel">
        <summary class="btn btn-sm">지우기</summary>
        <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/delete" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="password" name="password" placeholder="글 비밀번호" required>
          <button class="btn btn-danger btn-sm">확인</button>
        </form>
      </details>
    <% } %>
  </div>
  <% if (isAdmin) { %>
    <div class="admin-bar">
      <b>🛡 관리</b>
      <%- include('../partials/hidebtn', { kind: 'talk', id: talk.id, hidden: talk.hidden_at, back: '/talk/' + room.slug + '/' + talk.id }) %>
      <% if (talk.user_id && talk.username) { %>
        <a class="btn btn-sm btn-admin" href="/@<%= talk.username %>#admin">작성자 관리</a>
      <% } else if (!talk.user_id) { %>
        <form method="post" action="/admin/ip-ban" class="inline ban-form" data-confirm="이 손님의 IP에서 글쓰기를 막을까요?">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="talk"><input type="hidden" name="id" value="<%= talk.id %>"><input type="hidden" name="back" value="/talk/<%= room.slug %>/<%= talk.id %>">
          <input name="reason" placeholder="사유 (선택)" maxlength="100" aria-label="차단 사유"><button class="btn btn-sm btn-danger">IP 차단</button>
        </form>
      <% } %>
    </div>
  <% } %>
</article>

<section class="box" id="comments">
  <div class="box-head"><h2 class="box-title">💬 댓글 <%= comments.length %></h2></div>
  <% if (comments.length === 0) { %><div class="empty small">첫 댓글을 남겨 보세요.</div><% } %>
  <% if (comments.length) { %>
  <ul class="bubbles">
    <% comments.forEach(c => { const isOp = (talk.user_id && c.user_id === talk.user_id) || (!talk.user_id && !c.user_id && c.ip_prefix === talk.ip_prefix && c.nickname === talk.nickname); %>
      <li class="bubble-row <%= isOp ? 'op' : '' %> <%= c.hidden_at ? 'is-hidden-item' : '' %>" id="c<%= c.id %>">
        <% if (c.username) { %><a href="/@<%= c.username %>"><img class="av av-36" src="<%= avatar(c) %>" alt=""></a><% } else { %><span class="guest-av" aria-hidden="true">👤</span><% } %>
        <div class="bubble-wrap">
          <div class="bubble-who">
            <%- include('../partials/writer', { w: c, noAv: true }) %>
            <% if (isOp) { %><span class="tag">글쓴이</span><% } %>
            <span class="muted light"><%= ago(c.created_at) %></span>
            <% if (c.hidden_at) { %><span class="tag tag-hot">숨김</span><% } %>
            <%- include('../partials/hidebtn', { kind: 'tcomment', id: c.id, hidden: c.hidden_at, back: '/talk/' + room.slug + '/' + talk.id + '#c' + c.id, small: true }) %>
            <% if (isAdmin && !c.user_id) { %>
              <form method="post" action="/admin/ip-ban" class="inline" data-confirm="이 손님의 IP에서 글쓰기를 막을까요?">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="tcomment"><input type="hidden" name="id" value="<%= c.id %>"><input type="hidden" name="back" value="/talk/<%= room.slug %>/<%= talk.id %>#c<%= c.id %>">
                <button class="linkbtn tiny admin-link">IP 차단</button>
              </form>
            <% } %>
            <% if (c.user_id) { %>
              <% if (user && user.id === c.user_id) { %>
                <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/comments/<%= c.id %>/delete" class="inline" data-confirm="댓글을 지울까요?">
                  <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn tiny">지우기</button>
                </form>
              <% } %>
            <% } else { %>
              <details class="del-det">
                <summary class="linkbtn tiny">지우기</summary>
                <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/comments/<%= c.id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="password" name="password" placeholder="비밀번호" required>
                  <button class="btn btn-danger btn-sm">지우기</button>
                </form>
              </details>
            <% } %>
          </div>
          <div class="bubble"><%- nl2br(c.body) %></div>
        </div>
      </li>
    <% }) %>
  </ul>
  <% } %>
  <form method="post" action="/talk/<%= room.slug %>/<%= talk.id %>/comment" class="reply-form <%= user ? '' : 'guest' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (!user) { %>
      <input name="nickname" maxlength="20" placeholder="닉네임 (손님)" aria-label="닉네임">
      <input type="password" name="password" minlength="2" maxlength="100" placeholder="비밀번호" required autocomplete="new-password" aria-label="비밀번호">
    <% } %>
    <textarea name="body" rows="2" maxlength="1000" required placeholder="댓글 남기기..." aria-label="댓글"></textarea>
    <button class="btn btn-ink">보내기</button>
  </form>
</section>

<% if (around.length) { %>
<section class="box nearby">
  <div class="box-head"><h2 class="box-title"><%= room.emoji %> <%= room.name %>의 다른 글</h2></div>
  <% around.forEach(a => { %><a href="/talk/<%= room.slug %>/<%= a.id %>"><span class="flame"><%= a.fire - a.ice > 0 ? '🔥' + (a.fire - a.ice) : '·' %></span><span class="heat-title"><%= a.title %></span></a><% }) %>
</section>
<% } %>
<%- include('../partials/footer') %>
