<%- include('partials/header') %>
<section class="feed">
  <form class="searchbox" action="/search" method="get" role="search">
    <%- icon('search', 20) %>
    <input type="search" name="q" value="<%= q %>" placeholder="사람, Snippet, #태그 검색" aria-label="검색" autofocus>
  </form>
  <% if (people.length) { %>
    <% if (q) { %><div class="section-label">사람</div><% } else { %><div class="section-label">팔로우 추천</div><% } %>
    <% people.forEach(u => { %>
      <div class="person">
        <a href="/@<%= u.username %>"><%- avatar(u, 44) %></a>
        <a class="grow" href="/@<%= u.username %>"><div class="bold"><%= u.display_name %></div><div class="small muted">@<%= u.username %> · 팔로워 <%= num(u.followers) %>명</div><% if (u.bio) { %><div class="small person-bio"><%= u.bio %></div><% } %></a>
        <% if (user && user.username !== u.username) { %>
          <form method="post" action="/@<%= u.username %>/follow" class="follow-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="<%= qs('/search', { q }) %>"><button class="btn btn-sm">팔로우</button></form>
        <% } %>
      </div>
    <% }) %>
  <% } %>
  <% if (q) { %>
    <div class="section-label">Snippet</div>
    <% if (posts.length === 0) { %><div class="empty">'<%= q %>'에 맞는 Snippet이 없어요.</div><% } %>
    <% posts.forEach(p => { %><%- include('partials/post', { p, opts: { showParent: true } }) %><% }) %>
  <% } %>
</section>
<%- include('partials/footer') %>
