<%- include('../partials/header') %>
<div class="gal-head">
  <div>
    <h1 class="gal-title"><a href="/g/<%= g.slug %>"><%= g.is_minor ? 'ⓜ ' : '' %><%= g.name %> 갤러리</a></h1>
    <p class="muted small"><%= g.description %></p>
  </div>
  <a class="btn btn-primary" href="/g/<%= g.slug %>/write">✎ 글쓰기</a>
</div>
<div class="board-tools">
  <nav class="seg">
    <a href="<%= qs('/g/' + g.slug, { head, q }) %>" class="<%= mode === 'all' ? 'on' : '' %>">전체글</a>
    <a href="<%= qs('/g/' + g.slug, { mode: 'best', head, q }) %>" class="<%= mode === 'best' ? 'on' : '' %>">개념글</a>
  </nav>
  <nav class="heads">
    <a href="<%= qs('/g/' + g.slug, { mode: mode === 'best' ? 'best' : '', q }) %>" class="<%= !head ? 'on' : '' %>">전체</a>
    <% heads.forEach(h => { %><a href="<%= qs('/g/' + g.slug, { mode: mode === 'best' ? 'best' : '', head: h, q }) %>" class="<%= head === h ? 'on' : '' %>"><%= h %></a><% }) %>
  </nav>
</div>
<% if (q) { %><p class="small muted">'<%= q %>' 검색 결과 <%= total %>건 · <a href="<%= qs('/g/' + g.slug, { mode: mode === 'best' ? 'best' : '', head }) %>">검색 해제</a></p><% } %>
<table class="board">
  <thead>
    <tr><th class="c-num">번호</th><th class="c-head">말머리</th><th>제목</th><th class="c-writer">글쓴이</th><th class="c-date">작성일</th><th class="c-num">조회</th><th class="c-num">추천</th></tr>
  </thead>
  <tbody>
    <% if (posts.length === 0) { %>
      <tr><td colspan="7" class="empty"><%= mode === 'best' ? '추천 ' + threshold + '개 이상 받은 개념글이 아직 없어요.' : '아직 글이 없어요. 첫 글을 써 보세요!' %></td></tr>
    <% } %>
    <% posts.forEach(p => { %>
      <tr class="<%= p.up >= threshold ? 'is-concept' : '' %>">
        <td class="c-num"><%= p.id %></td>
        <td class="c-head"><%= p.head %></td>
        <td class="c-title">
          <a href="/g/<%= g.slug %>/<%= p.id %>"><% if (p.up >= threshold) { %><span class="concept-ico" title="개념글">★</span><% } else if (p.has_img) { %><span class="img-ico" title="이미지">🖼</span><% } %><%= p.title %></a><% if (p.ccount) { %> <span class="reply">[<%= p.ccount %>]</span><% } %>
          <div class="m-meta small muted"><%- include('../partials/writer', { w: p }) %> · <%= dcTime(p.created_at) %> · 조회 <%= num(p.views) %> · 추천 <%= p.up %></div>
        </td>
        <td class="c-writer"><%- include('../partials/writer', { w: p }) %></td>
        <td class="c-date" title="<%= fullTime(p.created_at) %>"><%= dcTime(p.created_at) %></td>
        <td class="c-num"><%= num(p.views) %></td>
        <td class="c-num"><%= p.up %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<div class="board-foot">
  <form class="board-search" method="get" action="/g/<%= g.slug %>">
    <% if (mode === 'best') { %><input type="hidden" name="mode" value="best"><% } %>
    <% if (head) { %><input type="hidden" name="head" value="<%= head %>"><% } %>
    <input type="search" name="q" value="<%= q %>" placeholder="제목+내용+글쓴이 검색" maxlength="50">
    <button class="btn btn-ghost btn-sm">검색</button>
  </form>
  <a class="btn btn-primary btn-sm" href="/g/<%= g.slug %>/write">✎ 글쓰기</a>
</div>
<%- include('../partials/pager', { base: '/g/' + g.slug, params: { mode: mode === 'best' ? 'best' : '', head, q }, page, pages }) %>
<%- include('../partials/footer') %>
