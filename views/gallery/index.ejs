<%- include('../partials/header') %>
<div class="section-head">
  <h1 class="h2">갤러리</h1>
  <a class="btn btn-ghost btn-sm" href="/g/new">ⓜ 마이너 갤러리 만들기</a>
</div>
<section class="card">
  <h2 class="box-title dc-bar">메인 갤러리</h2>
  <ul class="gal-list">
    <% main.forEach(g => { %>
      <li><a href="/g/<%= g.slug %>"><span class="gname"><%= g.name %></span><span class="muted small"><%= g.description %></span></a><span class="gstat small">오늘 <b><%= g.today %></b> · 전체 <%= num(g.total) %></span></li>
    <% }) %>
  </ul>
</section>
<section class="card">
  <h2 class="box-title dc-bar">마이너 갤러리</h2>
  <% if (minor.length === 0) { %>
    <div class="empty small">아직 마이너 갤러리가 없어요. 첫 번째로 만들어 보세요!</div>
  <% } else { %>
  <ul class="gal-list">
    <% minor.forEach(g => { %>
      <li><a href="/g/<%= g.slug %>"><span class="gname"><span class="minor-badge">ⓜ</span> <%= g.name %></span><span class="muted small"><%= g.description %></span></a><span class="gstat small">오늘 <b><%= g.today %></b> · 전체 <%= num(g.total) %></span></li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>
