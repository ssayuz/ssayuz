<%- include('partials/header') %>
<nav class="feed-tabs">
  <a href="/" class="<%= tab === 'foryou' ? 'on' : '' %>">추천</a>
  <a href="<%= user ? '/?feed=following' : '/login?next=%2F%3Ffeed%3Dfollowing' %>" class="<%= tab === 'following' ? 'on' : '' %>">팔로잉</a>
</nav>
<section class="feed">
  <% if (user) { %>
    <%- include('partials/composer', { cfg: { compact: true, id: 'home-composer' } }) %>
  <% } else { %>
    <div class="welcome">
      <span class="logo big">ssayuz</span>
      <h1 class="h2">짧게 말하고, 길게 이어지는 곳</h1>
      <p class="muted">500자 Snippet으로 생각을 나누고, 답글로 대화해요.</p>
      <div class="row centered"><a class="btn btn-ink" href="/signup">가입하기</a><a class="btn" href="/login">로그인</a></div>
    </div>
  <% } %>
  <% if (items.length === 0) { %>
    <div class="empty">
      <% if (tab === 'following') { %>팔로우한 사람의 Snippet이 아직 없어요.<br><a class="bold" href="/search">사람 찾아보기 →</a>
      <% } else { %>아직 Snippet이 없어요. 첫 Snippet을 올려 보세요!<% } %>
    </div>
  <% } %>
  <% items.forEach((it, i) => { %>
    <%- include('partials/post', { p: it.post, opts: { repostedBy: it.repostedBy } }) %>
    <% if (i === 2 && suggestions.length) { %>
      <div class="suggest">
        <div class="suggest-title">팔로우 추천</div>
        <div class="suggest-row">
          <% suggestions.forEach(s => { %>
            <div class="suggest-card">
              <a href="/@<%= s.username %>"><%- avatar(s, 56) %></a>
              <a class="bold small" href="/@<%= s.username %>"><%= s.display_name %></a>
              <span class="tiny muted">@<%= s.username %></span>
              <form method="post" action="/@<%= s.username %>/follow" class="follow-form">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/">
                <button class="btn btn-sm btn-ink btn-block">팔로우</button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% }) %>
  <% if (hasMore) { %><div class="more"><a class="btn" href="<%= qs('/', { feed: tab === 'following' ? 'following' : '', page: page + 1 }) %>">더 보기</a></div><% } %>
</section>
<%- include('partials/footer') %>
