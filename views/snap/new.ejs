<%- include('../partials/header') %>
<section class="box box-pad-lg narrow">
  <span class="kicker">snap</span>
  <h1 class="h2 mt">스냅 올리기</h1>
  <% if (error) { %><div class="alert mt"><%= error %></div><% } %>
  <form method="post" action="/snap/new?_csrf=<%= csrf %>" enctype="multipart/form-data" class="stack mt">
    <label class="drop">
      <input type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple required data-preview="#preview">
      <span class="drop-ico">📷</span><span class="bold">사진 고르기</span><span class="tiny muted light">최대 10장 · 여러 장이면 넘겨 보는 앨범이 돼요</span>
    </label>
    <div id="preview" class="preview"></div>
    <label>한 줄<textarea name="caption" rows="4" maxlength="2200" placeholder="지금 이 순간을 한 줄로... #태그 @친구"><%= caption %></textarea></label>
    <button class="btn btn-ink btn-block">올리기 ✦</button>
  </form>
</section>
<%- include('../partials/footer') %>
